<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:i_am.Pages"
             x:Class="i_am.Pages.SignUpView"
             x:DataType="pages:SignUpViewModel"
             Title="Rejestracja">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Utwórz konto" 
                   FontSize="28" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20"/>

            <Entry Placeholder="Email *"
                   Text="{Binding Email}"
                   Keyboard="Email"/>
            
            <Entry Placeholder="Nazwa użytkownika *"
                   Text="{Binding Username}"/>
            
            <Entry Placeholder="Hasło *"
                   Text="{Binding Password}" 
                   IsPassword="True"/>
            
            <Entry Placeholder="Numer telefonu (opcjonalnie)"
                   Text="{Binding PhoneNumber}"
                   Keyboard="Telephone"/>

            <Frame Padding="15" CornerRadius="10" Margin="0,10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Zaznacz, jeśli chcesz być opiekunem" FontAttributes="Bold"/>
                    
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding IsCaregiver}" 
                                  VerticalOptions="Center" />
                        <Label Text="Chcę przyjąć rolę opiekuna" 
                               VerticalOptions="Center"
                               FontSize="14" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Primary}"/>

            <Button Text="Zarejestruj się" 
                    Command="{Binding SignUpCommand}"
                    Margin="0,10"/>
            
            <Button Text="Masz już konto? Zaloguj się"
                    Command="{Binding NavigateSignInCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
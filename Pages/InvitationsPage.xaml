<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:i_am.ViewModels"
             xmlns:models="clr-namespace:i_am.Models"
             x:Class="i_am.Pages.InvitationsPage"
             x:DataType="vm:InvitationVM"
             Title="Zaproszenia">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- Wysyłanie zaproszenia -->
        <Frame Grid.Row="0" Padding="15" CornerRadius="10" Margin="0,0,0,20">
            <VerticalStackLayout Spacing="10">
                <Label Text="Wyślij zaproszenie" FontSize="18" FontAttributes="Bold" />
                <Entry Placeholder="Wpisz email osoby"
                       Text="{Binding RecipientEmail}"
                       Keyboard="Email" />
                <Button Text="Wyślij zaproszenie"
                        Command="{Binding SendInvitationCommand}" />
            </VerticalStackLayout>
        </Frame>

        <!-- Lista oczekujących zaproszeń -->
        <VerticalStackLayout Grid.Row="1">
            <Label Text="Aktualne zaproszenia" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   Margin="0,0,0,10" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}" />

            <CollectionView ItemsSource="{Binding PendingInvitations}"
                            EmptyView="Brak oczekujących zaproszeń">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Invitation">
                        <Frame Margin="0,0,0,10" Padding="15" CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                <!-- Nazwa - dla otrzymanych: SenderName, dla wysłanych: RecipientEmail -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding SenderName}"
                                       FontSize="16"
                                       FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSentByMe}" Value="True">
                                            <Setter Property="Text" Value="{Binding RecipientName}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Tekst opisu -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       FontSize="12"
                                       TextColor="Gray"
                                       Text="{Binding InviteTypeText}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSentByMe}" Value="True">
                                            <Setter Property="Text" Value="Wysłane przez Ciebie" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Przyciski dla OTRZYMANYCH zaproszeń -->
                                <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                       Spacing="10"
                                                       IsVisible="{Binding IsSentByMe, Converter={StaticResource InverseBoolConverter}}">
                                    <Button Text="✓"
                                            BackgroundColor="Green"
                                            TextColor="White"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            CornerRadius="25"
                                            Clicked="OnAcceptClicked" />

                                    <Button Text="✗"
                                            BackgroundColor="Red"
                                            TextColor="White"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            CornerRadius="25"
                                            Clicked="OnRejectClicked" />
                                </HorizontalStackLayout>

                                <!-- Label "Oczekujące" dla WYSŁANYCH zaproszeń -->
                                <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       BackgroundColor="Orange"
                                       Padding="15,10"
                                       CornerRadius="20"
                                       IsVisible="{Binding IsSentByMe}">
                                    <Label Text="Oczekujące"
                                           TextColor="White"
                                           FontSize="14"
                                           VerticalOptions="Center" />
                                </Frame>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

    </Grid>

</ContentPage>